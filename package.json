{
  "name": "reviewagent",
  "version": "1.5.0",
  "description": "ReviewAgent — Ascend AI Infra agent (Hermes-style CLI). Wake with `reviewagent`. Works with cc-switch via OPENAI_*/ANTHROPIC_* env.",
  "main": "bin/reviewagent.js",
  "bin": {
    "reviewagent": "./bin/reviewagent.js",
    "ra": "./bin/reviewagent.js",
    "review": "./bin/review.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node bin/reviewagent.js --version"
  },
  "keywords": [
    "reviewagent",
    "hermes",
    "claude-code",
    "cc-switch",
    "code-review",
    "ai-infra",
    "ascend",
    "npu",
    "cann",
    "pytorch",
    "mindspore",
    "vllm"
  ],
  "author": "ReviewAgent Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/enternalna-Koh/ReviewAgent.git"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "boxen": "^5.1.2"
  },
  "preferGlobal": true,
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "homepage": "https://github.com/enternalna-Koh/ReviewAgent"
}
